<div class="pdp-avatars" {{ block.shopify_attributes }} data-pdp-video>
  {%- if block.settings.heading != blank -%}
    <h3 class="pdp-avatars__title">{{ block.settings.heading }}</h3>
  {%- endif -%}
  <div class="pdp-avatars__row">
    {%- for i in (1..5) -%}
      {%- assign key = 'avatar_' | append: i -%}
      {%- assign img = block.settings[key] -%}
      {%- if img -%}
        <button class="pdp-avatars__img" type="button" data-video-open aria-label="Play video">
          <img src="{{ img | image_url: width: 180 }}" alt="" width="86" height="86" loading="lazy">
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if block.settings.video_url != blank -%}
    <dialog class="pdp-vmodal">
      <button class="pdp-vmodal__close" type="button" data-video-close aria-label="Close">&times;</button>
      <video class="pdp-vmodal__video" src="{{ block.settings.video_url }}" controls playsinline></video>
    </dialog>
  {%- endif -%}
</div>

{% stylesheet %}
  .pdp-avatars__title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 20px;
  }
  .pdp-vmodal {
    border: 0;
    border-radius: 16px;
    padding: 0;
    background: #000;
    max-width: min(90vw, 720px);
  }
  .pdp-vmodal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .pdp-vmodal__video {
    display: block;
    width: 100%;
    border-radius: 16px;
  }
  .pdp-vmodal__close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: 0;
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('[data-pdp-video]').forEach(function (root) {
      var dialog = root.querySelector('.pdp-vmodal');
      if (!dialog || !dialog.showModal) return;
      var video = dialog.querySelector('video');

      function close() {
        if (video) video.pause();
        dialog.close();
      }

      root.querySelectorAll('[data-video-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          dialog.showModal();
          if (video) video.play();
        });
      });
      dialog.querySelector('[data-video-close]').addEventListener('click', close);
      dialog.addEventListener('close', function () {
        if (video) video.pause();
      });
      // Clicking the backdrop closes the dialog
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog) close();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "PDP Avatars",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real People. Real Healing." },
    { "type": "url", "id": "video_url", "label": "Popup video URL (Shopify Files)" },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Avatar 4" },
    { "type": "image_picker", "id": "avatar_5", "label": "Avatar 5" }
  ],
  "presets": [{ "name": "PDP Avatars" }]
}
{% endschema %}
