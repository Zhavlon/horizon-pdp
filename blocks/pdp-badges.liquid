<div class="pdp-badges" {{ block.shopify_attributes }}>
  {%- if block.settings.stock_text != blank -%}
    <span class="pdp-badge pdp-badge--stock">{{ block.settings.stock_text }}</span>
  {%- endif -%}
  {%- if block.settings.viewers != blank -%}
    <span class="pdp-badge pdp-badge--view">{{ block.settings.viewers }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .pdp-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pdp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.2;
    color: var(--pdp-text);
    padding: 5px 12px;
    border-radius: 999px;
  }
  .pdp-badge::before {
    content: '';
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .pdp-badge--stock {
    background: var(--pdp-stock-bg);
  }
  .pdp-badge--stock::before {
    width: 10px;
    height: 10px;
    background: var(--pdp-stock-dot);
  }
  .pdp-badge--view {
    background: var(--pdp-viewers-bg);
  }
  .pdp-badge--view::before {
    width: 8px;
    height: 8px;
    background: var(--pdp-viewers-dot);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Badges",
  "settings": [
    { "type": "text", "id": "stock_text", "label": "Stock badge", "default": "Limited Stock" },
    { "type": "text", "id": "viewers", "label": "Viewers", "default": "23 people viewing this now" }
  ],
  "presets": [{ "name": "PDP Badges" }]
}
{% endschema %}
