{%- liquid
  assign product = closest.product
-%}

<div class="pdp-tabs" data-pdp-tabs {{ block.shopify_attributes }}>
  <div class="pdp-tabs__nav" role="tablist">
    <button class="pdp-tabs__navbtn is-active" data-tab="desc" role="tab" type="button" aria-selected="true">
      <span class="pdp-tabs__label">Description</span>
      <span class="pdp-tabs__ind"></span>
    </button>
    <button class="pdp-tabs__navbtn" data-tab="who" role="tab" type="button" aria-selected="false">
      <span class="pdp-tabs__label">Who is it for?</span>
      <span class="pdp-tabs__ind"></span>
    </button>
    <button class="pdp-tabs__navbtn" data-tab="ship" role="tab" type="button" aria-selected="false">
      <span class="pdp-tabs__label">Shipping and returns</span>
      <span class="pdp-tabs__ind"></span>
    </button>
    <button class="pdp-tabs__navbtn" data-tab="care" role="tab" type="button" aria-selected="false">
      <span class="pdp-tabs__label">Care Instructions</span>
      <span class="pdp-tabs__ind"></span>
    </button>
  </div>

  <div class="pdp-tabs__panels">
    <div class="pdp-tabs__panel is-active is-open" data-panel="desc">
      <button class="pdp-tabs__head" type="button">Description</button>
      <div class="pdp-tabs__body rte">{{ product.description }}</div>
    </div>

    <div class="pdp-tabs__panel" data-panel="who">
      <button class="pdp-tabs__head" type="button">Who is it for?</button>
      <div class="pdp-tabs__body rte">{{ block.settings.who }}</div>
    </div>

    <div class="pdp-tabs__panel" data-panel="ship">
      <button class="pdp-tabs__head" type="button">Shipping and returns</button>
      <div class="pdp-tabs__body rte">{{ block.settings.shipping }}</div>
    </div>

    <div class="pdp-tabs__panel" data-panel="care">
      <button class="pdp-tabs__head" type="button">Care Instructions</button>
      <div class="pdp-tabs__body rte">{{ block.settings.care }}</div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initTabs(root) {
      if (root.dataset.tabsInit) return;
      root.dataset.tabsInit = '1';

      var navBtns = root.querySelectorAll('.pdp-tabs__navbtn');
      var panels = root.querySelectorAll('.pdp-tabs__panel');
      var desktop = window.matchMedia('(min-width: 750px)');

      navBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.dataset.tab;
          navBtns.forEach(function (b) {
            var active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.classList.toggle('is-active', p.dataset.panel === key);
          });
        });
      });

      // Mobile only: the panel header toggles its own body (accordion)
      panels.forEach(function (panel) {
        var head = panel.querySelector('.pdp-tabs__head');
        if (!head) return;
        head.addEventListener('click', function () {
          if (desktop.matches) return;
          panel.classList.toggle('is-open');
        });
      });
    }

    document.querySelectorAll('[data-pdp-tabs]').forEach(initTabs);
  })();
</script>

{% schema %}
{
  "name": "PDP Tabs",
  "settings": [
    {
      "type": "richtext",
      "id": "who",
      "label": "Who is it for?",
      "default": "<p>Grounding can support you if you're:</p><ul><li>Struggling with poor sleep, racing thoughts, or insomnia</li><li>Waking up stiff, sore, or fatigued</li><li>Living with chronic pain, inflammation, or autoimmune issues</li><li>Experiencing anxiety, stress, or hormonal imbalance</li><li>Looking for a natural, non-invasive wellness solution</li></ul>"
    },
    {
      "type": "richtext",
      "id": "shipping",
      "label": "Shipping and returns",
      "default": "<ul><li>Free U.S. shipping on orders over $100</li><li>Fast delivery: 2–6 days (U.S. &amp; Canada), 7–10 days (EU &amp; international)</li><li>90-Day Money-Back Guarantee: try it risk-free. If you don't feel the benefits, send it back.</li><li>Returns: contact our support team for easy return instructions. Products must be in good condition.</li><li>Support: our team is available 24/7 to help with ordering, setup, or troubleshooting.</li></ul>"
    },
    {
      "type": "richtext",
      "id": "care",
      "label": "Care Instructions",
      "default": "<p>To maintain conductivity and extend the life of your grounding sheet:</p><ul><li>Wash on gentle cycle with mild detergent</li><li>Avoid bleach, fabric softeners, or dryer sheets</li><li>Air dry when possible, or tumble dry on low</li><li>Do not dry clean</li><li>Wash regularly to remove body oils that can affect performance</li></ul>"
    }
  ],
  "presets": [{ "name": "PDP Tabs" }]
}
{% endschema %}
