<div class="pdp-features" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="pdp-features__title">{{ block.settings.heading }}</p>
  {%- endif -%}
  <ul class="pdp-features__grid">
    {%- for feature in closest.product.metafields.custom.features.value -%}
      <li class="pdp-features__item">
        {%- if feature.icon.value -%}
          <img src="{{ feature.icon.value | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
        {%- endif -%}
        <span>{{ feature.text }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .pdp-features__title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 22px;
  }
  .pdp-features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 56px;
  }
  .pdp-features__item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.3;
  }
  .pdp-features__item img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  @media (max-width: 749px) {
    .pdp-features__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Features",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Why you need this?" }],
  "presets": [{ "name": "PDP Features" }]
}
{% endschema %}
