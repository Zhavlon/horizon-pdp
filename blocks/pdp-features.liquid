<div class="pdp-features" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <p class="pdp-features__title">{{ block.settings.heading }}</p>
  {% endif %}
  <ul class="pdp-features__grid">
    {% for f in product.metafields.custom.features.value %}
      <li class="pdp-features__item">
        {% if f.icon.value -%}
          <img src="{{ f.icon.value | image_url: width: 64 }}" alt="" width="28" height="28" loading="lazy">
        {%- endif %}
        <span>{{ f.text }}</span>
      </li>
    {% endfor %}
  </ul>
</div>
{% stylesheet %}
  .pdp-features__title {
    font-weight: 600;
    margin: 0 0 12px;
  }
  .pdp-features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 16px;
  }
  .pdp-features__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.4;
  }
  .pdp-features__item img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  @media (max-width: 749px) {
    .pdp-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "PDP Features",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Why you need this?" }]
}
{% endschema %}
