<div class="pdp pdp-bs" data-pdp-bs data-interval="{{ section.settings.autoplay | default: 10 }}">
  <div class="pdp-bs__inner">
    <div class="pdp-bs__head">
      <h2 class="pdp-bs__title">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p class="pdp-bs__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="pdp-bs__grid">
      <div class="pdp-bs__tabs" role="tablist">
        {% for block in section.blocks %}
          <button
            class="pdp-bs__tab{% if forloop.first %} is-active{% endif %}"
            data-tab="{{ forloop.index0 }}"
            type="button"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.tab_icon -%}
              <img src="{{ block.settings.tab_icon | image_url: width: 44 }}" alt="" width="22" height="22">
            {%- endif %}
            <span>{{ block.settings.name }}</span>
          </button>
        {% endfor %}
      </div>

      <div class="pdp-bs__media">
        {% for block in section.blocks %}
          <img
            class="pdp-bs__img{% if forloop.first %} is-active{% endif %}"
            data-panel="{{ forloop.index0 }}"
            src="{{ block.settings.image | image_url: width: 900 }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            alt="{{ block.settings.name }}"
            loading="lazy"
          >
        {% endfor %}
      </div>

      <div class="pdp-bs__cards">
        {% for block in section.blocks %}
          <div class="pdp-bs__card{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index0 }}">
            <h3 class="pdp-bs__card-title">{{ block.settings.name }}</h3>
            <p class="pdp-bs__card-intro">{{ block.settings.intro }}</p>
            <div class="pdp-bs__card-list rte">{{ block.settings.conditions }}</div>
            {% if block.settings.link_text != blank %}
              <a class="pdp-bs__card-link" href="{{ block.settings.link_url | default: '#' }}">
                {{- block.settings.link_text -}}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .pdp-bs {
    background: var(--pdp-cream);
  }
  .pdp-bs__inner {
    max-width: var(--pdp-max);
    margin-inline: auto;
    padding: 72px var(--pdp-gutter);
  }
  .pdp-bs__title {
    font-size: 64px;
    line-height: 1.2;
    margin: 0 0 16px;
    max-width: 682px;
  }
  .pdp-bs__intro {
    max-width: 645px;
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .pdp-bs__grid {
    display: grid;
    grid-template-columns: 340px 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .pdp-bs__tabs {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .pdp-bs__tab {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid #d9d5ca;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .pdp-bs__tab.is-active {
    background: var(--pdp-dark);
    color: #fff;
    border-color: var(--pdp-dark);
  }
  .pdp-bs__tab.is-active img {
    filter: invert(1);
  }
  .pdp-bs__media {
    position: relative;
  }
  .pdp-bs__img {
    display: none;
    width: 100%;
    border-radius: 16px;
  }
  .pdp-bs__img.is-active {
    display: block;
  }
  .pdp-bs__card {
    display: none;
    background: var(--pdp-dark);
    color: #fff;
    border-radius: 16px;
    padding: 40px;
  }
  .pdp-bs__card.is-active {
    display: block;
  }
  .pdp-bs__card-title {
    font-size: 48px;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .pdp-bs__card-list ul {
    margin: 12px 0;
  }
  .pdp-bs__card-link {
    display: inline-block;
    margin-top: 16px;
    color: #fff;
    font-weight: 700;
  }
  @media (max-width: 989px) {
    .pdp-bs__grid {
      grid-template-columns: 1fr;
    }
    .pdp-bs__media {
      order: -1;
    }
    .pdp-bs__inner {
      padding: 48px var(--pdp-gutter);
    }
    .pdp-bs__title,
    .pdp-bs__card-title {
      font-size: 24px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('[data-pdp-bs]').forEach(function (root) {
      var tabs = [].slice.call(root.querySelectorAll('.pdp-bs__tab'));
      if (!tabs.length) return;
      var n = tabs.length,
        cur = 0,
        timer = null;
      var ms = (parseInt(root.getAttribute('data-interval'), 10) || 10) * 1000;
      function go(i) {
        cur = (i + n) % n;
        tabs.forEach(function (t, k) {
          t.classList.toggle('is-active', k === cur);
        });
        root.querySelectorAll('[data-panel]').forEach(function (p) {
          p.classList.toggle('is-active', +p.getAttribute('data-panel') === cur);
        });
      }
      function start() {
        stop();
        timer = setInterval(function () {
          go(cur + 1);
        }, ms);
      }
      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }
      tabs.forEach(function (t, k) {
        t.addEventListener('click', function () {
          go(k);
          start();
        });
      });
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      start();
    });
  })();
</script>

{% schema %}
{
  "name": "PDP · Body systems",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One Natural Solution. Whole-Body Benefits." },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Grounding supports every major system in your body, helping relieve chronic symptoms, restore balance, and promote long-term wellness. Backed by 20+ years of research and thousands of customer results."
    },
    {
      "type": "range",
      "id": "autoplay",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "Auto-switch every",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Neurological & Mental Health" },
        { "type": "image_picker", "id": "tab_icon", "label": "Tab icon" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "intro", "label": "Intro" },
        { "type": "richtext", "id": "conditions", "label": "Conditions (bullet list)" },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Explore the science behind these benefits"
        },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP · Body systems",
      "blocks": [
        { "type": "system" },
        { "type": "system" },
        { "type": "system" },
        { "type": "system" },
        { "type": "system" },
        { "type": "system" }
      ]
    }
  ]
}
{% endschema %}
