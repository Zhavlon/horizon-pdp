{%- comment -%}
  Self-hosted brand fonts: Recoleta for headings, Figtree for body copy.
{%- endcomment -%}
{{ 'Recoleta-Regular.woff2' | asset_url | preload_tag: as: 'font' }}
{{ 'Figtree-Regular.woff2' | asset_url | preload_tag: as: 'font' }}
<style>
  @font-face {
    font-family: 'Recoleta';
    src: url('{{ "Recoleta-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Figtree';
    src: url('{{ "Figtree-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Figtree';
    src: url('{{ "Figtree-Bold.woff2" | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
</style>
